var vm = import("vm");
var count = 0;
var code = @{ count = count + 1; context.value = context.value + 1; return context.value; };
def main() {
    if (vm != import("vm")) { return byte(-1); }
    if (get_type(code) != "NativeObject") { return byte(-1); }
    if (get_type(vm.get_type) != "Error") { return byte(-1); }
    if (get_type(eval_bytecode) != "Error") { return byte(-1); }
    var defaults = vm.get_module_paths();
    var paths = array();
    if (vm.set_module_paths(paths) != true) { return byte(-1); }
    if (vm.get_module_paths().Length != 0) { return byte(-1); }
    if (get_type(import("stdio")) != "Error") { return byte(-1); }
    if (get_type(paths) != "Array") { return byte(-1); }
    if (get_type(paths[1] = 12) != "Error") { return byte(-1); }
    if (get_type(paths.Length = 1) != "Error") { return byte(-1); }
    if (paths.add(12) != true) { return byte(-1); }
    paths.add(13);
    paths.add(12);
    if (get_type(paths[0] = 99) != "Error") { return byte(-1); }
    if (get_type(paths.extra) != "Error") { return byte(-1); }
    if (get_type(paths.extra = 99) != "Error") { return byte(-1); }
    if (get_type(paths[3]) != "Error") { return byte(-1); }
    if (get_type(paths.remove_at(3)) != "Error") { return byte(-1); }
    if (paths[0] != 12) { return byte(-1); }
    if (paths.remove(12) != true) { return byte(-1); }
    if (paths.Length != 2) { return byte(-1); }
    if (paths[0] != 13) { return byte(-1); }
    if (paths[1] != 12) { return byte(-1); }
    if (paths.remove_at(1) != true) { return byte(-1); }
    if (paths.remove(12) != false) { return byte(-1); }
    if (paths.Length != 1) { return byte(-1); }
    if (get_type(vm.set_module_paths(paths)) != "Error") { return byte(-1); }
    if (vm.get_module_paths().Length != 0) { return byte(-1); }
    if (vm.set_module_paths(defaults) != true) { return byte(-1); }
    var stdio = import("stdio");
    if (get_type(stdio) != "NativeObject") { return byte(-1); }
    if (count != 0) { return byte(-1); }
    var state = object(); state.value = 40;
    vm.eval_bytecode(code, state);
    if (vm.eval_bytecode(code, state) != 42) { return byte(-1); }
    var handle = stdio.IO.OpenFile("compiled-block-test.bin", "w");
    var written = stdio.IO.Write(handle, code);
    stdio.IO.CloseFile(handle);
    if (written != code.Length) { return byte(-1); }
    handle = stdio.IO.OpenFile("compiled-block-test.bin", "r");
    var loaded = stdio.IO.Read(handle, code.Length);
    stdio.IO.CloseFile(handle);
    if (vm.eval_bytecode(loaded, state) != 43) { return byte(-1); }
    stdio.Console.PrintLine("compiled bytecode persisted and executed");
    return null;
}
