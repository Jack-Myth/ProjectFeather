var vm = import("vm");

def Dispatch(binding) {
    var args = array();
    args.Add(binding.Receiver);
    if (binding.Context != null) { args.Add(binding.Context); }
    var index = 1;
    while (index < vm.GetArgumentCount()) {
        args.Add(vm.GetArgument(index));
        index = index + 1;
    }
    return vm.Invoke(binding.Function, args);
}

var meta = object();
meta.__call = Dispatch;

export def Create(fn, self, context = null) {
    var binding = object();
    binding.Function = fn;
    binding.Receiver = self;
    binding.Context = context;
    return vm.SetMetaObject(binding, meta);
}
